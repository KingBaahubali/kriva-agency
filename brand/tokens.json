{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Kriva",
    "version": "1.0.0",
    "colorRatio": "60 canvas / 30 surface / 10 accent",
    "contrastBasis": "WCAG 2.2 AA measured against basalt (#0A0C10) and graphite (#12151C)"
  },
  "color": {
    "basalt": { "DEFAULT": "#0A0C10", "deep": "#06070A" },
    "graphite": { "DEFAULT": "#12151C", "raised": "#171B24", "hover": "#1C212B" },
    "signal": { "DEFAULT": "#FF4B1F", "soft": "#FF6B45", "dim": "#2A140E" },
    "ink": {
      "100": "#F4F5F7",
      "200": "#C9CDD6",
      "300": "#9BA1AE",
      "400": "#7E8595"
    },
    "line": {
      "DEFAULT": "rgba(255,255,255,0.08)",
      "strong": "rgba(255,255,255,0.14)",
      "specular": "rgba(255,255,255,0.08)"
    },
    "status": { "ok": "#3DDC97", "warn": "#F5B544", "error": "#FF6B6B" }
  },
  "contrast": {
    "ink-100/basalt": "17.94:1",
    "ink-200/basalt": "12.29:1",
    "ink-300/basalt": "7.55:1",
    "ink-400/basalt": "5.29:1",
    "ink-300/graphite": "7.05:1",
    "ink-400/graphite": "4.94:1",
    "ink-400/graphite-raised": "4.66:1",
    "signal/basalt": "5.85:1",
    "signal/graphite": "5.46:1",
    "basalt/signal (button label)": "5.85:1",
    "rule": "Never place ink-400 on graphite.hover (4.36:1). White text on signal fails AA — always use basalt labels."
  },
  "font": {
    "family": {
      "display": ["Plus Jakarta Sans Variable", "ui-sans-serif", "system-ui", "sans-serif"],
      "body": ["Geist Variable", "ui-sans-serif", "system-ui", "sans-serif"],
      "mono": ["Geist Mono Variable", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display-xl": ["clamp(2.6rem, 1.55rem + 4.6vw, 5.25rem)", { "lineHeight": "0.98", "letterSpacing": "-0.035em" }],
      "display-lg": ["clamp(2.15rem, 1.45rem + 3vw, 3.75rem)", { "lineHeight": "1.03", "letterSpacing": "-0.03em" }],
      "display-md": ["clamp(1.7rem, 1.3rem + 1.7vw, 2.6rem)", { "lineHeight": "1.08", "letterSpacing": "-0.025em" }],
      "title": ["clamp(1.2rem, 1.08rem + 0.5vw, 1.45rem)", { "lineHeight": "1.25", "letterSpacing": "-0.015em" }],
      "body-lg": ["clamp(1.0625rem, 1rem + 0.3vw, 1.2rem)", { "lineHeight": "1.6" }],
      "body": ["1rem", { "lineHeight": "1.65" }],
      "small": ["0.875rem", { "lineHeight": "1.55" }],
      "caption": ["0.8125rem", { "lineHeight": "1.5", "letterSpacing": "0.01em" }],
      "eyebrow": ["0.75rem", { "lineHeight": "1.4", "letterSpacing": "0.14em" }]
    }
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "space": {
    "section": "clamp(5rem, 3rem + 8vw, 9.5rem)",
    "gutter": "clamp(1.25rem, 0.8rem + 2vw, 2.5rem)"
  },
  "shadow": {
    "specular": "inset 0 1px 0 rgba(255,255,255,0.08)",
    "lift": "0 24px 48px -24px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.08)",
    "signal": "0 0 0 1px rgba(255,75,31,0.4), 0 12px 32px -12px rgba(255,75,31,0.45)"
  },
  "motion": {
    "easing": { "kinetic": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "duration": { "fast": "160ms", "base": "320ms", "slow": "640ms", "reveal": "900ms" },
    "spring": { "stiffness": 420, "damping": 30, "mass": 0.8 }
  },
  "layout": {
    "maxWidth": "1320px",
    "headerHeight": "72px"
  }
}
